{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tonnetz Pro",
  "version": "0.1.0",
  "identifier": "io.tonnetz.pro",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tonnetz Pro",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "maximized":  true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../ui/samples"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}